---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Section from "../../components/Section.astro";
import site from "../../content/site.json";

const { troubleshooting } = site.docs;
---

<BaseLayout
	title={`${troubleshooting.title} — ${site.product.name}`}
	description={troubleshooting.intro}
>
	<Section variant="hero">
		<div class="doc-page">
			<article>
				<p class="breadcrumb">
					<a href="/docs">Docs</a> / {troubleshooting.title}
				</p>
				<h1>{troubleshooting.title}</h1>
				<p class="ui-lede">{troubleshooting.intro}</p>

				<ul class="issue-list">
					{
						troubleshooting.issues.map((issue) => (
							<li>
								<p class="issue-title">{issue.title}</p>
								<p class="issue-body">{issue.resolution}</p>
							</li>
						))
					}
				</ul>

				<p style="margin-top: 1.5rem; color: var(--text-muted);">
					{troubleshooting.cta} <a href="/contact">Contact us</a>.
				</p>

				<div class="doc-feedback">
					<span>{troubleshooting.feedback}</span>
					<div class="doc-feedback-actions">
						<button type="button" class="ui-button ui-button-secondary" disabled>Yes</button>
						<button type="button" class="ui-button ui-button-secondary" disabled>No</button>
					</div>
				</div>
			</article>

			<aside class="sidebar" aria-label="Related">
				<h4>Related</h4>
				<ul>
					<li><a href="/docs/getting-started">Getting Started</a></li>
					<li><a href="/docs/sdk-setup">SDK Setup</a></li>
					<li><a href="/contact">Contact support</a></li>
				</ul>
			</aside>
		</div>
	</Section>
</BaseLayout>

<style>
	.doc-page {
		display: grid;
		gap: 2rem;
	}

	@media (min-width: 860px) {
		.doc-page {
			grid-template-columns: minmax(0, 1fr) 220px;
		}
	}

	.breadcrumb {
		font-size: 0.8rem;
		color: var(--text-subtle);
		margin-bottom: 0.75rem;
	}

	.breadcrumb a {
		color: inherit;
	}

	.issue-list {
		list-style: none;
		padding: 0;
		margin: 0;
		display: grid;
		gap: 0.75rem;
	}

	.issue-list li {
		background: var(--surface-raised);
		border: 1px solid var(--border);
		border-radius: var(--radius-sm);
		padding: 0.9rem 1rem;
	}

	.issue-title {
		font-weight: 600;
		margin: 0 0 0.25rem;
	}

	.issue-body {
		color: var(--text-muted);
		font-size: 0.925rem;
		margin: 0;
	}

	.doc-feedback {
		margin-top: 2.5rem;
		padding-top: 1.5rem;
		border-top: 1px solid var(--border);
		color: var(--text-muted);
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 1rem;
		flex-wrap: wrap;
	}

	.doc-feedback-actions {
		display: flex;
		gap: 0.5rem;
	}

	.sidebar {
		position: sticky;
		top: 5rem;
		height: fit-content;
		border-left: 1px solid var(--border);
		padding-left: 1.25rem;
		font-size: 0.875rem;
		color: var(--text-muted);
	}

	.sidebar h4 {
		font-size: 0.75rem;
		letter-spacing: 0.09em;
		text-transform: uppercase;
		color: var(--text-subtle);
		margin: 0 0 0.5rem;
	}

	.sidebar ul {
		list-style: none;
		padding: 0;
		margin: 0;
		display: grid;
		gap: 0.25rem;
	}

	.sidebar a {
		color: var(--text-muted);
	}
</style>
