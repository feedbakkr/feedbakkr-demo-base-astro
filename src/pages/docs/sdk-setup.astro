---
import BaseLayout from "../../layouts/BaseLayout.astro";
import Section from "../../components/Section.astro";
import site from "../../content/site.json";

const { sdkSetup } = site.docs;
---

<BaseLayout title={`${sdkSetup.title} — ${site.product.name}`} description={sdkSetup.intro}>
	<Section variant="hero">
		<div class="doc-page">
			<article>
				<p class="breadcrumb">
					<a href="/docs">Docs</a> / {sdkSetup.title}
				</p>
				<h1>{sdkSetup.title}</h1>
				<p class="ui-lede">{sdkSetup.intro}</p>

				{
					sdkSetup.sections.map((s) => (
						<div class="doc-section">
							<h2>{s.title}</h2>
							<p>{s.body}</p>
							{"code" in s && s.code ? (
								<pre>
									<code>{s.code}</code>
								</pre>
							) : null}
						</div>
					))
				}

				<div class="ui-callout" style="margin-top: 1.5rem;">{sdkSetup.callout}</div>

				<div class="doc-feedback">
					<span>{sdkSetup.feedback}</span>
					<div class="doc-feedback-actions">
						<button type="button" class="ui-button ui-button-secondary" disabled>Yes</button>
						<button type="button" class="ui-button ui-button-secondary" disabled>No</button>
					</div>
				</div>
			</article>

			<aside class="sidebar" aria-label="Related">
				<h4>Related</h4>
				<ul>
					<li><a href="/docs/getting-started">Getting Started</a></li>
					<li><a href="/docs/troubleshooting">Troubleshooting</a></li>
					<li><a href="/contact">Contact support</a></li>
				</ul>
			</aside>
		</div>
	</Section>
</BaseLayout>

<style>
	.doc-page {
		display: grid;
		gap: 2rem;
	}

	@media (min-width: 860px) {
		.doc-page {
			grid-template-columns: minmax(0, 1fr) 220px;
		}
	}

	.breadcrumb {
		font-size: 0.8rem;
		color: var(--text-subtle);
		margin-bottom: 0.75rem;
	}

	.breadcrumb a {
		color: inherit;
	}

	.doc-section h2 {
		margin-top: 2rem;
	}

	.doc-feedback {
		margin-top: 2.5rem;
		padding-top: 1.5rem;
		border-top: 1px solid var(--border);
		color: var(--text-muted);
		display: flex;
		align-items: center;
		justify-content: space-between;
		gap: 1rem;
		flex-wrap: wrap;
	}

	.doc-feedback-actions {
		display: flex;
		gap: 0.5rem;
	}

	.sidebar {
		position: sticky;
		top: 5rem;
		height: fit-content;
		border-left: 1px solid var(--border);
		padding-left: 1.25rem;
		font-size: 0.875rem;
		color: var(--text-muted);
	}

	.sidebar h4 {
		font-size: 0.75rem;
		letter-spacing: 0.09em;
		text-transform: uppercase;
		color: var(--text-subtle);
		margin: 0 0 0.5rem;
	}

	.sidebar ul {
		list-style: none;
		padding: 0;
		margin: 0;
		display: grid;
		gap: 0.25rem;
	}

	.sidebar a {
		color: var(--text-muted);
	}
</style>
