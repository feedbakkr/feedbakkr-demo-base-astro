{
  "name": "feedbakkr-demo-base-astro",
  "type": "module",
  "version": "0.0.1",
  "engines": {
    "node": ">=22.12.0"
  },
  "packageManager": "pnpm@9.15.4",
  "scripts": {
    "dev": "astro dev",
    "build": "astro check && astro build",
    "preview": "astro preview",
    "check": "astro check",
    "astro": "astro",
    "security:audit": "pnpm audit --audit-level high",
    "security:audit:moderate": "pnpm audit --audit-level moderate",
    "security:osv": "osv-scanner --recursive .",
    "security:scan": "pnpm run security:audit && pnpm run security:osv",
    "security:scan:full": "pnpm run security:audit:moderate && pnpm run security:osv"
  },
  "dependencies": {
    "astro": "^6.1.8"
  },
  "devDependencies": {
    "@astrojs/check": "^0.9.8",
    "typescript": "^6.0.3"
  },
  "pnpm": {
    "overrides": {
      "fast-uri": ">=3.1.2",
      "devalue": ">=5.8.1"
    }
  }
}
